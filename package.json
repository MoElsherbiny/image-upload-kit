{
  "name": "img-upload-kit",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Full-featured image upload, Sharp AVIF/WebP optimization, LQIP & BlurHash generation, dominant edge-color extraction, pluggable StorageAdapter, and customizable/headless React UI components.",
  "author": "Mohamed Elsherbiny <mo@buildwithsherbo.com> (https://www.buildwithsherbo.com/)",
  "homepage": "https://upload-kit.buildwithsherbo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoElsherbiny/image-upload-kit.git"
  },
  "bugs": {
    "url": "https://github.com/MoElsherbiny/image-upload-kit/issues"
  },
  "keywords": [
    "image-upload",
    "headless-upload",
    "blurhash",
    "lqip",
    "sharp",
    "avif",
    "webp",
    "image-optimization",
    "react-upload",
    "dominant-color",
    "storage-adapter"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "img-upload-kit": "dist/cli.js",
    "image-upload-kit": "dist/cli.js",
    "blur-cli": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "require": {
        "types": "./dist/storage.d.cts",
        "default": "./dist/storage.cjs"
      }
    },
    "./blur": {
      "import": {
        "types": "./dist/blur.d.ts",
        "default": "./dist/blur.js"
      },
      "require": {
        "types": "./dist/blur.d.cts",
        "default": "./dist/blur.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "commander": "^14.0.0"
  },
  "peerDependencies": {
    "lqip-modern": "^2.2.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sharp": "^0.34.5"
  },
  "peerDependenciesMeta": {
    "lqip-modern": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^31.0.0",
    "lqip-modern": "^2.2.1",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
