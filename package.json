{
  "name": "img-upload-kit",
  "version": "2.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Multi-platform image upload, Sharp AVIF/WebP optimization, smart aspect-ratio cropping, presigned uploads, content-hash deduplication, LQIP & BlurHash generation, dominant edge-color extraction, pluggable StorageAdapter, and React, Vue/Nuxt, Angular, React Native & Headless UI components.",
  "author": "Mohamed Elsherbiny <mo@buildwithsherbo.com> (https://www.buildwithsherbo.com/)",
  "homepage": "https://upload-kit.buildwithsherbo.com",
  "funding": "https://github.com/sponsors/MoElsherbiny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoElsherbiny/image-upload-kit.git"
  },
  "bugs": {
    "url": "https://github.com/MoElsherbiny/image-upload-kit/issues"
  },
  "keywords": [
    "image-upload",
    "headless-upload",
    "react-upload",
    "vue-upload",
    "nuxt",
    "angular-upload",
    "react-native-upload",
    "expo-image-picker",
    "presigned-upload",
    "blurhash",
    "lqip",
    "sharp",
    "avif",
    "webp",
    "image-optimization",
    "dominant-color",
    "storage-adapter"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs/*.md",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "client": ["./dist/client.d.ts"],
      "server": ["./dist/server.d.ts"],
      "server/handler": ["./dist/server-handler.d.ts"],
      "storage": ["./dist/storage.d.ts"],
      "blur": ["./dist/blur.d.ts"],
      "react": ["./dist/react.d.ts"],
      "headless": ["./dist/headless.d.ts"],
      "vue": ["./dist/vue.d.ts"],
      "angular": ["./dist/angular.d.ts"],
      "react-native": ["./dist/react-native.d.ts"],
      "cli": ["./dist/cli.d.ts"],
      "styles.css": ["./dist/styles.css.d.cts"],
      "styles/tokens.css": ["./dist/styles/tokens.css.d.cts"],
      "styles/primitives.css": ["./dist/styles/primitives.css.d.cts"],
      "styles/quality-and-inputs.css": ["./dist/styles/quality-and-inputs.css.d.cts"],
      "styles/dropzone-and-tiles.css": ["./dist/styles/dropzone-and-tiles.css.d.cts"],
      "styles/modals-and-dock.css": ["./dist/styles/modals-and-dock.css.d.cts"],
      "styles/animated-image.css": ["./dist/styles/animated-image.css.d.cts"]
    }
  },
  "bin": {
    "img-upload-kit": "dist/bin.js",
    "image-upload-kit": "dist/bin.js",
    "blur-cli": "dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./server/handler": {
      "import": {
        "types": "./dist/server-handler.d.ts",
        "default": "./dist/server-handler.js"
      },
      "require": {
        "types": "./dist/server-handler.d.cts",
        "default": "./dist/server-handler.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "require": {
        "types": "./dist/storage.d.cts",
        "default": "./dist/storage.cjs"
      }
    },
    "./blur": {
      "import": {
        "types": "./dist/blur.d.ts",
        "default": "./dist/blur.js"
      },
      "require": {
        "types": "./dist/blur.d.cts",
        "default": "./dist/blur.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./react-native": {
      "react-native": {
        "types": "./dist/react-native.d.ts",
        "default": "./dist/react-native.js"
      },
      "import": {
        "types": "./dist/react-native.d.ts",
        "default": "./dist/react-native.js"
      },
      "require": {
        "types": "./dist/react-native.d.cts",
        "default": "./dist/react-native.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.cts",
      "default": "./dist/styles.css"
    },
    "./styles/tokens.css": {
      "types": "./dist/styles/tokens.css.d.cts",
      "default": "./dist/styles/tokens.css"
    },
    "./styles/primitives.css": {
      "types": "./dist/styles/primitives.css.d.cts",
      "default": "./dist/styles/primitives.css"
    },
    "./styles/quality-and-inputs.css": {
      "types": "./dist/styles/quality-and-inputs.css.d.cts",
      "default": "./dist/styles/quality-and-inputs.css"
    },
    "./styles/dropzone-and-tiles.css": {
      "types": "./dist/styles/dropzone-and-tiles.css.d.cts",
      "default": "./dist/styles/dropzone-and-tiles.css"
    },
    "./styles/modals-and-dock.css": {
      "types": "./dist/styles/modals-and-dock.css.d.cts",
      "default": "./dist/styles/modals-and-dock.css"
    },
    "./styles/animated-image.css": {
      "types": "./dist/styles/animated-image.css.d.cts",
      "default": "./dist/styles/animated-image.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-max-lines.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm run test && npm run check:dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {},
  "peerDependencies": {
    "@angular/core": ">=17.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.74.0",
    "sharp": "^0.34.5",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "react-native": { "optional": true },
    "sharp": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.13"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
